#version 410 core
layout(quads, fractional_odd_spacing, cw) in;

struct Material {
    sampler2D texture_diffuse;
    sampler2D texture_specular;
    sampler2D texture_normal;
    sampler2D texture_height;

    bool has_texture_diffuse_map;
    bool has_texture_specular_map;
    bool has_texture_normal_map;
    bool has_texture_height_map;
};

uniform Material material;
uniform mat4 model;
uniform mat4 view;
uniform mat4 projection;

in vec2 TextureCoord[]; // From TCS

out float Height;
out vec2 TexCoords; // Pass to fragment shader

void main()
{
    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    // Correct corner indexing for texture coordinates
    vec2 t00 = TextureCoord[0]; // (u0,v0)
    vec2 t10 = TextureCoord[1]; // (u1,v0)
    vec2 t01 = TextureCoord[2]; // (u0,v1)
    vec2 t11 = TextureCoord[3]; // (u1,v1)

    // Correct bilinear interpolation
    vec2 t0 = (t10 - t00) * u + t00;
    vec2 t1 = (t11 - t01) * u + t01;
    vec2 texCoords = (t1 - t0) * v + t0;
    TexCoords = texCoords; // Pass to fragment shader

    // Sample height from heightmap
    Height = material.has_texture_height_map
        ? texture(material.texture_height, texCoords).r * 64.0 - 16.0
        : 0.0;

    // Correct corner indexing for positions
    vec4 p00 = gl_in[0].gl_Position; // (u0,v0)
    vec4 p10 = gl_in[1].gl_Position; // (u1,v0)
    vec4 p01 = gl_in[2].gl_Position; // (u0,v1)
    vec4 p11 = gl_in[3].gl_Position; // (u1,v1)

    // Correct tangent vectors for normal calculation
    vec4 uVec = p10 - p00; // (u1,v0) - (u0,v0)
    vec4 vVec = p01 - p00; // (u0,v1) - (u0,v0)
    vec4 normal = normalize(vec4(cross(vVec.xyz, uVec.xyz), 0));

    // Correct bilinear interpolation for position
    vec4 p0 = (p10 - p00) * u + p00;
    vec4 p1 = (p11 - p01) * u + p01;
    vec4 p = (p1 - p0) * v + p0;

    // Add displacement along the normal
    p += normal * Height;

    // Final clip-space position
    gl_Position = projection * view * model * p;
}
