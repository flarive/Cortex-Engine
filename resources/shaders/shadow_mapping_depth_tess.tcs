#version 440 core
layout(vertices = 4) out;

uniform mat4 model;

in vec3 FragPos[];  // Object-space positions from the vertex shader

out vec3 tcFragPos[];  // Pass object-space positions to TES

void main()
{
    tcFragPos[gl_InvocationID] = FragPos[gl_InvocationID];
    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;

    // Fixed tessellation levels for shadow mapping
    if (gl_InvocationID == 0)
    {
        gl_TessLevelOuter[0] = 16.0;
        gl_TessLevelOuter[1] = 16.0;
        gl_TessLevelOuter[2] = 16.0;
        gl_TessLevelOuter[3] = 16.0;
        gl_TessLevelInner[0] = 16.0;
        gl_TessLevelInner[1] = 16.0;
    }
}
